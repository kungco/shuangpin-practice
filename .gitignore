# 本地工作数据（AI 助手记忆 / 会话记录，不上传）
.workbuddy/

# 测试依赖（linkedom 等，属于开发期工具，体积大且可重装）
# 注意：_test/package.json 与 _test/package-lock.json **要提交**，
# 它们锁定了依赖版本，保证本地 / CI 装出同一棵树。只忽略装好的目录。
_test/node_modules/

# 视觉验证（tools/shot.mjs）的产物：
#   - 临时 Chrome profile 落在 _test/.chrome-profile/（脚本按自身位置解析，
#     不再硬编码绝对路径，所以这里能对上）
#   - 截图与注入脚本可能落在 _test/ 或 _test/tools/ 下
_test/.chrome-profile/
_test/**/shot-*.png
_test/**/inj-*.js
# 根目录下做截图注入用的临时脚本（shot.mjs 的 script-file 参数）
.shot-*.js
shot-*.png

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# 日志与临时文件
*.log
tmp/
temp/

# 分发包产物（网页版 zip 由 _test/tools/make_web_package.py 生成，
# 桌面版 .exe 由 desktop/ 构建）。两者都通过 GitHub Release 分发，不进仓库。
dist/

# 本地凭据（防手滑）
*.credentials
.my-credentials
.env
.env.local
