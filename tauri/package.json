{
  "name": "shuangpin-practice-tauri",
  "version": "1.7.0",
  "private": true,
  "description": "双拼练习的 Tauri 外壳（用系统 WebView2）。应用本体仍是仓库根的零依赖静态站点，此目录只负责打包。",
  "author": "kungco",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "node tools/prepare-frontend.mjs",
    "icons": "python tools/make_icons.py",
    "dev": "node tools/prepare-frontend.mjs && tauri dev",
    "build": "node tools/prepare-frontend.mjs && tauri build",
    "build:portable": "node tools/prepare-frontend.mjs && tauri build --no-bundle"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
